{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qhqhyjpqgrvrxjiosoha.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "quanto-tempo-mcp",
      "version": "0.1.0",
      "title": "Quanto tempo? MCP"
    },
    "tools": [
      {
        "name": "list_events",
        "title": "Listar eventos",
        "description": "Lista os eventos (datas importantes) do usuário autenticado, opcionalmente filtrando por categoria ou favoritos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Filtro opcional pela categoria exata do evento."
            },
            "onlyFavorites": {
              "type": "boolean",
              "description": "Se true, retorna somente eventos marcados como favoritos."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de eventos a retornar (padrão 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_event",
        "title": "Criar evento",
        "description": "Cria uma nova data/evento para o usuário autenticado no app Quanto Tempo?",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Nome/descrição do evento."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Categoria do evento (ex.: 'Aniversário de casamento')."
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data do evento no formato ISO (YYYY-MM-DD)."
            },
            "recurring": {
              "type": "boolean",
              "description": "Se o evento se repete anualmente."
            },
            "favorite": {
              "type": "boolean",
              "description": "Marcar como favorito."
            }
          },
          "required": [
            "label",
            "category",
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_event",
        "title": "Excluir evento",
        "description": "Exclui permanentemente um evento do usuário autenticado. Requer confirmação por ser irreversível.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Identificador do evento a excluir."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_lists",
        "title": "Listar listas compartilhadas",
        "description": "Retorna as listas que o usuário autenticado criou ou participa como membro.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "time_since",
        "title": "Calcular tempo desde/até uma data",
        "description": "Calcula o tempo decorrido ou faltante (anos, meses, dias e total de dias) entre hoje e uma data informada.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data no formato YYYY-MM-DD."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
